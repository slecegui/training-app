# PostgreSQL (used by Docker Compose)
POSTGRES_DB=training_online
POSTGRES_USER=training
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://training:change-me-locally@localhost:5432/training_online
UPLOAD_DIR=./storage/uploads
CORS_ORIGINS=http://localhost:5173
# Required only for the protected coaching context inspection endpoint.
COACHING_DEBUG_TOKEN=replace-with-a-local-secret
SESSION_SECRET=replace-with-a-long-random-local-secret
SESSION_HTTPS_ONLY=false
# Fernet key for the optional experimental Garmin connection. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_TOKEN_KEY=

# Frontend
FRONTEND_PORT=5173
